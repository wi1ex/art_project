---
import { content, languages, type Language } from '../../data/content';
import '../../styles/global.css';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = content[lang];
const anchors = ['portfolio', 'services', 'about', 'contact'];
const services = ['electrical', 'smart', 'solar', 'heat'];
const partners = ['developers', 'designers', 'builders', 'architects'];
const symbols = ['◇', '≡', '◷', '⌁', '▤', '▧'];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{t.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {languages.map(code => <link rel="alternate" hreflang={code} href={`/${code}/`} />)}
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="header container">
      <a href={`/${lang}/`} class="brand" aria-label="ART PROJECT"><img src="/favicon.svg" alt="" width="40" height="40" /><span>ART<br />PROJECT</span></a>
      <nav class="desktop-nav" aria-label={t.menu}>{t.nav.map((label, i) => <a href={`#${anchors[i]}`}>{label}</a>)}</nav>
      <div class="languages" aria-label="Language">{languages.map(code => <a href={`/${code}/`} lang={code} aria-current={code === lang ? 'page' : undefined}>{code.toUpperCase()}</a>)}</div>
      <details class="mobile-menu"><summary aria-label={t.menu}><span aria-hidden="true">☰</span></summary><nav aria-label={t.menu}>{t.nav.map((label, i) => <a href={`#${anchors[i]}`}>{label}</a>)}</nav></details>
    </header>
    <main id="main">
      <section class="hero container">
        <div class="hero-copy"><p class="eyebrow">— {t.eyebrow}</p><p class="hero-brand" aria-hidden="true">ART<br />PROJECT</p><h1>{t.hero}</h1><p class="muted intro">{t.intro}</p><a class="button dark" href="#contact">{t.cta}<span aria-hidden="true">↗</span></a></div>
        <img class="hero-image" src="/images/hero.webp" width="955" height="895" alt="" fetchpriority="high" />
      </section>
      <section id="services" class="services section">
        <div class="container center"><h2>{t.servicesTitle}</h2><p class="muted">{t.servicesIntro}</p><div class="arrows"><button type="button" data-slide="-1" aria-label={t.previous} aria-controls="service-list">←</button><button type="button" data-slide="1" aria-label={t.next} aria-controls="service-list">→</button></div></div>
        <ul id="service-list" class="service-grid container">{t.services.map(([title, description], i) => <li><img src={`/images/service-${services[i]}.webp`} width="490" height="425" alt="" loading="lazy" decoding="async" /><h3>{title}</h3><p class="muted">{description}</p></li>)}</ul>
      </section>
      <section id="portfolio" class="container section work"><div class="section-heading"><div><p class="eyebrow green">{t.workLabel}</p><h2>{t.workTitle}</h2></div><p class="muted aside">{t.workIntro}</p></div><img class="comparison" src="/images/comparison.webp" width="1200" height="659" alt={t.workTitle.replace('\n', ' ')} loading="lazy" decoding="async" /></section>
      <section id="about" class="container section"><p class="eyebrow green">{t.principlesLabel}</p><h2>{t.principlesTitle}</h2><p class="muted section-intro">{t.principlesIntro}</p><ul class="principles">{t.principles.map(([title, description], i) => <li><div><h3>{title}</h3><p class="muted">{description}</p></div><span class="principle-symbol" aria-hidden="true">{symbols[i]}</span></li>)}</ul></section>
      <section class="container section"><div class="section-heading"><div><p class="eyebrow green">{t.b2bLabel}</p><h2>{t.b2bTitle}</h2></div><p class="muted aside">{t.b2bIntro}</p></div><ul class="partners">{t.partners.map(([title, description], i) => <li class={partners[i]}><div class="partner-copy"><h3>{title}</h3><p class="muted">{description}</p><a class="button light" href="#contact">{t.cooperate}<span aria-hidden="true">↗</span></a></div><img src={`/images/${partners[i]}.webp`} alt="" width="462" height="360" loading="lazy" decoding="async" /></li>)}</ul></section>
      <section class="container section reviews"><p class="eyebrow green">{t.reviewsLabel}</p><h2>{t.reviewsTitle}</h2><div class="review-placeholder"><span aria-hidden="true">“</span><p class="muted">{t.reviewsNote}</p></div></section>
      <section id="contact" class="container section contact"><div class="contact-form"><h2>{t.contactTitle}</h2><p class="muted">{t.contactIntro}</p><form aria-describedby="form-status"><label for="phone">{t.phone}</label><input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+420" disabled /><label class="consent"><input type="checkbox" disabled />{t.consent}</label><button class="button olive" type="submit" disabled>{t.submit}</button><p class="form-status" id="form-status">{t.demo}</p></form></div><div class="messenger"><img src="/images/designers.webp" alt="" width="462" height="360" loading="lazy" decoding="async" /><div><h2>{t.messenger}</h2><p>{t.messengerNote}</p><span class="messenger-label">Telegram</span></div></div></section>
    </main>
    <footer><div class="container footer-grid"><div><p class="footer-cta">{t.footerCta}</p><a class="button footer-button" href="#contact">{t.cta}<span aria-hidden="true">→</span></a></div><div><p class="eyebrow">{t.nav[1]}</p>{t.services.map(([title]) => <a href="#services">{title}</a>)}</div><div><p class="eyebrow">ART PROJECT</p>{t.nav.map((title, i) => <a href={`#${anchors[i]}`}>{title}</a>)}</div><div><p class="eyebrow">Language</p>{languages.map(code => <a href={`/${code}/`} lang={code}>{({ru:'Русский', en:'English', cs:'Čeština'})[code]}</a>)}</div></div><div class="container footer-bottom"><a href={`/${lang}/`} class="brand"><img src="/favicon.svg" alt="" width="32" height="32" /><span>ART<br />PROJECT</span></a><small>© {new Date().getFullYear()} ART PROJECT. {t.rights}</small></div></footer>
    <script>
      const list = document.querySelector<HTMLElement>('#service-list');
      document.querySelectorAll<HTMLButtonElement>('[data-slide]').forEach(button => {
        button.addEventListener('click', () => {
          if (!list) return;
          const card = list.querySelector('li');
          const step = (card?.getBoundingClientRect().width ?? list.clientWidth) + 20;
          list.scrollBy({ left: Number(button.dataset.slide) * step, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        });
      });
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
    </script>
  </body>
</html>
