---
import { content, languages, type Language } from '../../data/content';
import '../../styles/fonts.css';
import '../../styles/global.css';
import { company } from '../../data/company';
import { interfaceText } from '../../data/interface';
import Comparison from '../../components/Comparison.astro';
import Reviews from '../../components/Reviews.astro';
import MessengerLinks from '../../components/MessengerLinks.astro';
import LeadForm from '../../components/LeadForm.astro';
import Footer from '../../components/Footer.astro';
import MobileMenu from '../../components/MobileMenu.astro';
import Icon from '../../components/Icon.astro';
import { statistics } from '../../data/statistics';
import { ClientRouter } from 'astro:transitions';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = content[lang];
const ui = interfaceText[lang];
const anchors = ['portfolio', 'services', 'about', 'contact'];
const services = ['electrical', 'smart', 'solar', 'heat'];
const partners = ['developers', 'designers', 'builders', 'architects'];
const principles = ['safety', 'precision', 'timing', 'materials', 'approach', 'guarantee'];
const headerLanguages = [
  { code: 'ru', label: 'RU' },
  { code: 'cs', label: 'CZ' },
  { code: 'en', label: 'ENG' },
] as const;
---
<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{t.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {languages.map(code => <link rel="alternate" hreflang={code} href={`/${code}/`} />)}
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="header container">
      <a href={`/${lang}/`} class="brand" aria-label="ART PROJECT"><img src="/images/logo.svg" alt="" width="84" height="70" /><span>ART<br />PROJECT</span></a>
      <nav class="desktop-nav" aria-label={t.menu}>{t.nav.map((label, i) => <a href={`#${anchors[i]}`}>{label}</a>)}</nav>
      <div class="header-contact"><a href={company.telephone}>{company.phone}</a><MessengerLinks lang={lang} compact /></div>
      <div class="languages" aria-label="Language">{headerLanguages.map(({ code, label }) => <a href={`/${code}/`} lang={code} data-astro-prefetch aria-current={code === lang ? 'page' : undefined}>{label}</a>)}</div>
      <MobileMenu lang={lang} />
    </header>
    <main id="main">
      <section class="hero container">
        <div class="hero-copy"><p class="eyebrow"><span>{t.eyebrow}</span></p><p class="hero-brand" aria-hidden="true">ART<br />PROJECT</p><h1>{t.hero}</h1><p class="muted intro">{t.intro}</p><a class="button dark" href="#contact">{t.cta}<Icon name="arrow" /></a><ul class="hero-statistics">{(['10+', '100%', '250+'] as const).map((value, i) => <li><span class="statistic-icon"><Icon name={(['building', 'check', 'award'] as const)[i]} /></span><div><strong>{value}</strong><p>{statistics[lang][i]}</p></div></li>)}</ul></div>
        <picture><source media="(max-width: 640px)" srcset="/images/hero-mobile.webp" width="430" height="900" /><img class="hero-image" src="/images/hero.webp" width="1048" height="1046" alt="" fetchpriority="high" /></picture>
      </section>
      <section id="services" class="services section">
        <div class="container center"><h2>{t.servicesTitle}</h2><p class="muted">{t.servicesIntro}</p><div class="arrows" data-carousel-controls><button type="button" data-slide="-1" aria-label={t.previous} aria-controls="service-list"><Icon name="arrow-prev" /></button><button type="button" data-slide="1" aria-label={t.next} aria-controls="service-list"><Icon name="arrow-control" /></button></div></div>
        <ul id="service-list" class="service-grid">{t.services.map(([title, description], i) => <li><picture>{i === 0 && <source media="(max-width: 640px)" srcset="/images/service-electrical-mobile.webp" width="384" height="406" />}<img src={`/images/service-${services[i]}.webp`} width="489" height="430" alt="" loading="lazy" decoding="async" /></picture><h3>{title}</h3><p class="muted">{description}</p></li>)}</ul>
      </section>
      <section id="portfolio" class="container section work"><div class="section-heading"><div><p class="eyebrow green">{t.workLabel}</p><h2>{t.workTitle}</h2></div><p class="muted aside">{t.workIntro}</p></div><Comparison lang={lang} /></section>
      <section id="about" class="container section"><p class="eyebrow green">{t.principlesLabel}</p><h2>{t.principlesTitle}</h2><p class="muted section-intro">{t.principlesIntro}</p><ul class="principles">{t.principles.map(([title, description], i) => <li><div><h3>{title}</h3><p class="muted">{description}</p></div><img class="principle-image" src={`/images/principle-${principles[i]}.webp`} width="250" height="323" alt="" loading="lazy" decoding="async" /></li>)}</ul></section>
      <section class="container section b2b"><div class="section-heading"><div><p class="eyebrow green">{t.b2bLabel}</p><h2>{t.b2bTitle}</h2></div><p class="muted aside">{t.b2bMobileIntro ? <><span class="b2b-intro-desktop">{t.b2bIntro}</span><span class="b2b-intro-mobile">{t.b2bMobileIntro}</span></> : t.b2bIntro}</p></div><ul class="partners">{t.partners.map(([title, description], i) => <li class={partners[i]}><div class="partner-copy"><h3>{title}</h3><p class="muted">{description}</p><a class="button light" href="#contact">{t.cooperate}<Icon name="arrow" /></a></div><img src={`/images/partner-${partners[i]}.webp`} alt="" width="462" height="360" loading="lazy" decoding="async" /></li>)}</ul></section>
      <Reviews lang={lang} />
      <section id="contact" class="container section contact"><LeadForm lang={lang} /><div class="messenger"><img src="/images/messenger.webp" alt="" width="835" height="690" loading="lazy" decoding="async" /><div><h2>{ui.mobileMessenger ? <><span class="messenger-copy-desktop">{t.messenger}</span><span class="messenger-copy-mobile">{ui.mobileMessenger.title}</span></> : t.messenger}</h2><p>{ui.mobileMessenger ? <><span class="messenger-copy-desktop">{ui.messengerNote}</span><span class="messenger-copy-mobile">{ui.mobileMessenger.note}</span></> : ui.messengerNote}</p><MessengerLinks lang={lang} /></div></div></section>
    </main>
    <Footer lang={lang} />
    <script>
      // Document listeners survive ClientRouter swaps; resolve the current DOM per event.
      document.addEventListener('click', event => {
        if (!(event.target instanceof Element)) return;
        const selectedLanguage = event.target.closest<HTMLAnchorElement>('a[lang]')?.getAttribute('lang');
        if (selectedLanguage === 'cs' || selectedLanguage === 'en' || selectedLanguage === 'ru') {
          try { localStorage.setItem('art-project-language', selectedLanguage); } catch { /* Navigation remains available without storage. */ }
        }
        const button = event.target.closest<HTMLButtonElement>('[data-slide]');
        if (button) {
          const list = document.querySelector<HTMLElement>('#service-list');
          if (!list) return;
          const card = list.querySelector('li');
          const gap = parseFloat(getComputedStyle(list).columnGap) || 0;
          const step = (card?.getBoundingClientRect().width ?? list.clientWidth) + gap;
          const direction = Number(button.dataset.slide);
          const end = list.scrollWidth - list.clientWidth;
          const next = direction > 0 && list.scrollLeft >= end - 2 ? 0 : direction < 0 && list.scrollLeft <= 2 ? end : list.scrollLeft + direction * step;
          list.scrollTo({ left: next, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        }
      });
    </script>
  </body>
</html>
