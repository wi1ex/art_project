---
import { content, languages, type Language } from '../../data/content';
import '../../styles/fonts.css';
import '../../styles/global.css';
import { company } from '../../data/company';
import { interfaceText } from '../../data/interface';
import Comparison from '../../components/Comparison.astro';
import Reviews from '../../components/Reviews.astro';
import MessengerLinks from '../../components/MessengerLinks.astro';
import { ClientRouter } from 'astro:transitions';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = content[lang];
const ui = interfaceText[lang];
const anchors = ['portfolio', 'services', 'about', 'contact'];
const services = ['electrical', 'smart', 'solar', 'heat'];
const partners = ['developers', 'designers', 'builders', 'architects'];
const principles = ['safety', 'precision', 'timing', 'materials', 'approach', 'guarantee'];
---
<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{t.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {languages.map(code => <link rel="alternate" hreflang={code} href={`/${code}/`} />)}
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="header container">
      <a href={`/${lang}/`} class="brand" aria-label="ART PROJECT"><img src="/images/logo.svg" alt="" width="84" height="70" /><span>ART<br />PROJECT</span></a>
      <nav class="desktop-nav" aria-label={t.menu}>{t.nav.map((label, i) => <a href={`#${anchors[i]}`}>{label}</a>)}</nav>
      <div class="header-contact"><a href={company.telephone}>{company.phone}</a><MessengerLinks lang={lang} compact /></div>
      <div class="languages" aria-label="Language">{languages.map(code => <a href={`/${code}/`} lang={code} data-astro-prefetch aria-current={code === lang ? 'page' : undefined}>{code.toUpperCase()}</a>)}</div>
      <details class="mobile-menu"><summary aria-label={t.menu}><span aria-hidden="true">☰</span></summary><nav aria-label={t.menu}>{t.nav.map((label, i) => <a href={`#${anchors[i]}`}>{label}</a>)}</nav></details>
    </header>
    <main id="main">
      <section class="hero container">
        <div class="hero-copy"><p class="eyebrow">— {t.eyebrow}</p><p class="hero-brand" aria-hidden="true">ART<br />PROJECT</p><h1>{t.hero}</h1><p class="muted intro">{t.intro}</p><a class="button dark" href="#contact">{t.cta}<span aria-hidden="true">↗</span></a></div>
        <picture><source media="(max-width: 640px)" srcset="/images/hero-mobile.webp" width="430" height="900" /><img class="hero-image" src="/images/hero.webp" width="1048" height="1046" alt="" fetchpriority="high" /></picture>
      </section>
      <section id="services" class="services section">
        <div class="container center"><h2>{t.servicesTitle}</h2><p class="muted">{t.servicesIntro}</p><div class="arrows" data-carousel-controls><button type="button" data-slide="-1" aria-label={t.previous} aria-controls="service-list">←</button><button type="button" data-slide="1" aria-label={t.next} aria-controls="service-list">→</button></div></div>
        <ul id="service-list" class="service-grid">{t.services.map(([title, description], i) => <li><img src={`/images/service-${services[i]}.webp`} width="490" height="425" alt="" loading="lazy" decoding="async" /><h3>{title}</h3><p class="muted">{description}</p></li>)}</ul>
      </section>
      <section id="portfolio" class="container section work"><div class="section-heading"><div><p class="eyebrow green">{t.workLabel}</p><h2>{t.workTitle}</h2></div><p class="muted aside">{t.workIntro}</p></div><Comparison lang={lang} /></section>
      <section id="about" class="container section"><p class="eyebrow green">{t.principlesLabel}</p><h2>{t.principlesTitle}</h2><p class="muted section-intro">{t.principlesIntro}</p><ul class="principles">{t.principles.map(([title, description], i) => <li><div><h3>{title}</h3><p class="muted">{description}</p></div><img class="principle-image" src={`/images/principle-${principles[i]}.webp`} width="250" height="323" alt="" loading="lazy" decoding="async" /></li>)}</ul></section>
      <section class="container section"><div class="section-heading"><div><p class="eyebrow green">{t.b2bLabel}</p><h2>{t.b2bTitle}</h2></div><p class="muted aside">{t.b2bIntro}</p></div><ul class="partners">{t.partners.map(([title, description], i) => <li class={partners[i]}><div class="partner-copy"><h3>{title}</h3><p class="muted">{description}</p><a class="button light" href="#contact">{t.cooperate}<span aria-hidden="true">↗</span></a></div><img src={`/images/partner-${partners[i]}.webp`} alt="" width="462" height="360" loading="lazy" decoding="async" /></li>)}</ul></section>
      <Reviews lang={lang} />
      <section id="contact" class="container section contact"><div class="contact-form"><h2>{t.contactTitle}</h2><p class="muted">{t.contactIntro}</p><form aria-describedby="form-status"><label for="phone">{t.phone}</label><input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+420" disabled /><label class="consent"><input type="checkbox" disabled />{t.consent}</label><button class="button olive" type="submit" disabled>{t.submit}</button><p class="form-status" id="form-status">{t.demo}</p></form></div><div class="messenger"><img src="/images/messenger.webp" alt="" width="835" height="690" loading="lazy" decoding="async" /><div><h2>{t.messenger}</h2><p>{ui.messengerNote}</p><MessengerLinks lang={lang} /></div></div></section>
    </main>
    <footer><div class="container footer-grid"><div><p class="footer-cta">{t.footerCta}</p><a class="button footer-button" href="#contact">{t.cta}<span aria-hidden="true">→</span></a></div><div><p class="eyebrow">{t.nav[1]}</p>{t.services.map(([title]) => <a href="#services">{title}</a>)}</div><div><p class="eyebrow">ART PROJECT</p>{t.nav.map((title, i) => <a href={`#${anchors[i]}`}>{title}</a>)}</div><div><p class="eyebrow">Language</p>{languages.map(code => <a href={`/${code}/`} lang={code}>{({ru:'Русский', en:'English', cs:'Čeština'})[code]}</a>)}</div></div><div class="container footer-bottom"><a href={`/${lang}/`} class="brand"><img src="/images/logo-light.svg" alt="" width="42" height="36" /><span>ART<br />PROJECT</span></a><a class="footer-phone" href={company.telephone}>{company.phone}</a><MessengerLinks lang={lang} compact /><small>© {new Date().getFullYear()} ART PROJECT. {t.rights}</small></div></footer>
    <script>
      // Document listeners survive ClientRouter swaps; resolve the current DOM per event.
      document.addEventListener('click', event => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest<HTMLButtonElement>('[data-slide]');
        if (button) {
          const list = document.querySelector<HTMLElement>('#service-list');
          if (!list) return;
          const card = list.querySelector('li');
          const gap = parseFloat(getComputedStyle(list).columnGap) || 0;
          const step = (card?.getBoundingClientRect().width ?? list.clientWidth) + gap;
          const direction = Number(button.dataset.slide);
          const end = list.scrollWidth - list.clientWidth;
          const next = direction > 0 && list.scrollLeft >= end - 2 ? 0 : direction < 0 && list.scrollLeft <= 2 ? end : list.scrollLeft + direction * step;
          list.scrollTo({ left: next, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        }
        const menu = event.target.closest<HTMLDetailsElement>('.mobile-menu');
        if (menu && event.target.closest('a')) menu.open = false;
      });
      document.addEventListener('keydown', event => {
        const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
        if (event.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
