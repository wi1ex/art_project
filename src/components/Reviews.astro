---
import { reviews } from '../data/reviews';
import { content, type Language } from '../data/content';
import { interfaceText } from '../data/interface';
const { lang } = Astro.props as { lang: Language };
const t = content[lang];
const labels = interfaceText[lang];
const ordered = [reviews[4], reviews[5], reviews[6], reviews[7], reviews[8], reviews[9], reviews[10], reviews[0], reviews[1], reviews[2], reviews[3], reviews[11], reviews[12]];
---
<section class="section reviews" aria-labelledby="reviews-heading">
  <div class="container section-heading">
    <div><p class="eyebrow green">{t.reviewsLabel}</p><h2 id="reviews-heading">{t.reviewsTitle}</h2></div>
    <div class="rating"><span class="stars" aria-hidden="true">★★★★★</span><strong aria-label={`${labels.rating}: 5.0`}>5.0</strong><p>{reviews.length} {labels.reviews}</p></div>
  </div>
  <div class="review-strip" tabindex="0" role="region" aria-label={t.reviewsLabel}>
    {ordered.map(review => (
      <article class="review-card">
        <div class="review-header"><span class="avatar" style={`--avatar: ${review.color}`} aria-hidden="true"></span><div><h3 lang="ru">{review.name}</h3><p>{review.role[lang]}</p></div><span class="stars" aria-label="5 / 5">★★★★★</span></div>
        <blockquote>{review.text[lang]}</blockquote>
      </article>
    ))}
  </div>
  {labels.translation && <p class="container translation-note">{labels.translation}</p>}
</section>
