---
import { reviews, reviewSummary } from '../data/reviews';
import { content, type Language } from '../data/content';
import { interfaceText } from '../data/interface';
import Icon from './Icon.astro';
const { lang } = Astro.props as { lang: Language };
const t = content[lang];
const labels = interfaceText[lang];
const ordered = [reviews[4], reviews[5], reviews[6], reviews[7], reviews[8], reviews[9], reviews[10], reviews[0], reviews[1], reviews[2], reviews[3], reviews[11]];
---
<section id="reviews" class="section reviews" aria-labelledby="reviews-heading">
  <div class="container section-heading">
    <div><p class="eyebrow green">{t.reviewsLabel}</p><h2 id="reviews-heading">{t.reviewsTitle}</h2></div>
    <div class="rating">
      <span class="stars" aria-hidden="true">{Array.from({ length: 5 }, () => <Icon name="star" />)}</span>
      <strong aria-label={`${labels.rating}: ${reviewSummary.rating}`}>{reviewSummary.rating}</strong>
      <p>{labels.rating} · {reviewSummary.count} {labels.reviews}</p>
      <button class="review-autoplay" type="button" data-review-autoplay data-pause={labels.pauseReviews} data-resume={labels.resumeReviews} aria-controls="review-strip" hidden>{labels.pauseReviews}</button>
    </div>
  </div>
  <div class="review-strip" id="review-strip" tabindex="0" role="region" aria-label={t.reviewsLabel}>
    {ordered.map(review => (
      <article class="review-card" lang={review.lang}>
        <div class="review-header"><span class="avatar" style={`--avatar: ${review.color}`} aria-hidden="true"></span><div><h3>{review.name}</h3><p>{review.role[review.lang]}</p></div><span class="stars" aria-label="5 / 5">{Array.from({ length: 5 }, () => <Icon name="star" />)}</span></div>
        <blockquote>{`"${review.text[review.lang]}"`}</blockquote>
      </article>
    ))}
  </div>
</section>

<style>
  .review-autoplay {
    min-height: 44px;
    padding-inline: 12px;
    margin-top: 8px;
    border: 0;
    border-radius: 6px;
    background: #f4f4f2;
    color: #333;
    font-size: 13px;
  }
  .review-autoplay:hover { background: #e9eee4; }
</style>

<script>
  let disposeReviewLoop = () => {};

  function initializeReviewLoop() {
    const strip = document.querySelector<HTMLElement>('.review-strip');
    const toggle = document.querySelector<HTMLButtonElement>('[data-review-autoplay]');
    if (!strip || !toggle || strip.scrollWidth <= strip.clientWidth) return;

    const cards = [...strip.querySelectorAll<HTMLElement>('.review-card')];
    const duplicateCards = () => cards.map(card => {
      const copy = card.cloneNode(true) as HTMLElement;
      copy.inert = true;
      copy.setAttribute('aria-hidden', 'true');
      return copy;
    });

    const before = duplicateCards();
    const after = duplicateCards();
    // Start each cycle in the top row of a new column, even with an odd card count.
    if (cards.length % 2) {
      const spacer = document.createElement('span');
      spacer.setAttribute('aria-hidden', 'true');
      before.push(spacer);
      strip.append(spacer.cloneNode());
    }
    strip.prepend(...before);
    strip.append(...after);

    const controller = new AbortController();
    const { signal } = controller;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let start = 0;
    let end = 0;
    let step = 0;
    let idleTimer: ReturnType<typeof setTimeout>;
    let autoplayTimer: ReturnType<typeof setTimeout>;
    let inView = false;
    let paused = false;
    let activePointer: number | undefined;

    function measure() {
      const origin = before[0].offsetLeft;
      start = cards[0].offsetLeft - origin;
      end = after[0].offsetLeft - origin;
      step = cards[2].offsetLeft - cards[0].offsetLeft;
    }

    const recenter = () => {
      const left = strip.scrollLeft;
      // Allow for fractional CSS pixels when the desktop layout is scaled.
      if (left < start - 1) strip.scrollTo({ left: left + start, behavior: 'instant' });
      else if (left >= end - 1) strip.scrollTo({ left: left - (end - start), behavior: 'instant' });
    };

    const scheduleAutoplay = () => {
      clearTimeout(autoplayTimer);
      if (!inView || paused || reducedMotion.matches || document.hidden || activePointer !== undefined || strip.matches(':focus-within')) return;
      autoplayTimer = setTimeout(() => {
        strip.scrollBy({ left: step, behavior: 'smooth' });
        scheduleAutoplay();
      }, 3200);
    };

    const settleScroll = () => {
      recenter();
      scheduleAutoplay();
    };

    measure();
    strip.scrollTo({ left: start, behavior: 'instant' });
    const resize = new ResizeObserver(() => {
      measure();
      recenter();
    });
    resize.observe(strip);

    const intersection = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      scheduleAutoplay();
    });
    intersection.observe(strip);

    if ('onscrollend' in window) {
      strip.addEventListener('scrollend', settleScroll, { signal });
    } else {
      strip.addEventListener('scroll', () => {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(settleScroll, 150);
      }, { passive: true, signal });
    }

    const syncMotionPreference = () => {
      toggle.hidden = reducedMotion.matches;
      scheduleAutoplay();
    };
    syncMotionPreference();
    reducedMotion.addEventListener('change', syncMotionPreference, { signal });
    document.addEventListener('visibilitychange', scheduleAutoplay, { signal });
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.textContent = paused ? toggle.dataset.resume! : toggle.dataset.pause!;
      if (paused) strip.scrollTo({ left: strip.scrollLeft, behavior: 'instant' });
      scheduleAutoplay();
    }, { signal });
    strip.addEventListener('focus', scheduleAutoplay, { signal });
    strip.addEventListener('blur', scheduleAutoplay, { signal });
    strip.addEventListener('wheel', event => {
      if (event.deltaX || event.shiftKey) scheduleAutoplay();
    }, { passive: true, signal });
    strip.addEventListener('pointerdown', event => {
      activePointer = event.pointerId;
      scheduleAutoplay();
    }, { passive: true, signal });
    const endPointer = (event: PointerEvent) => {
      if (event.pointerId !== activePointer) return;
      activePointer = undefined;
      scheduleAutoplay();
    };
    window.addEventListener('pointerup', endPointer, { signal });
    window.addEventListener('pointercancel', endPointer, { signal });

    disposeReviewLoop = () => {
      controller.abort();
      resize.disconnect();
      intersection.disconnect();
      clearTimeout(idleTimer);
      clearTimeout(autoplayTimer);
    };
  }

  document.addEventListener('astro:page-load', initializeReviewLoop);
  document.addEventListener('astro:before-swap', () => disposeReviewLoop());
</script>
