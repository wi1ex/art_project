---
import { company } from '../data/company';
import { interfaceText } from '../data/interface';
import type { Language } from '../data/content';
const { lang, compact = false } = Astro.props as { lang: Language; compact?: boolean };
const t = interfaceText[lang];
---
<div class:list={['messenger-links', { 'messenger-links--compact': compact }]}>
  <a href={company.telegram} target="_blank" rel="noopener noreferrer" aria-label={t.telegram} class="telegram-link"><img src="/images/telegram.svg" alt="" width="30" height="30" />{!compact && <span>{t.telegram}</span>}</a>
  <a href={company.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={t.whatsapp} class="whatsapp-link"><img src="/images/whatsapp.svg" alt="" width="30" height="30" />{!compact && <span>{t.whatsapp}</span>}</a>
</div>
